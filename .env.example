# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public SEO, Domain & Analytics Configuration
# Canonical site origin used for sitemap.xml and robots.txt (defaults to https://nfm.eprbazaar.com)
SITE_BASE_URL="https://nfm.eprbazaar.com"
VITE_SITE_URL="https://nfm.eprbazaar.com"
# Public WhatsApp click-to-chat destination number without + (defaults to 917439103014)
VITE_WHATSAPP_REDIRECT_NUMBER="917439103014"
# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=""
# Optional Google Search Console verification token (meta name="google-site-verification")
VITE_GSC_VERIFICATION_TOKEN=""

# Private Lead Notification Secrets (SERVER-SIDE ONLY - NEVER expose with VITE_ prefix)
# Destination WhatsApp number in international E.164 digits without + (e.g., 917439103014)
LEAD_WHATSAPP_TO=""
# Meta WhatsApp Business Cloud API Permanent/System User Access Token
WHATSAPP_ACCESS_TOKEN=""
# Meta WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""
# Meta Graph API Version (optional, defaults to v21.0)
WHATSAPP_API_VERSION="v21.0"
